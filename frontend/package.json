{
  "name": "frontend",
  "private": true,
  "version": "0.4.7",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:lib": "node --test tests/lib/bootstrap_config_contract.test.mjs tests/lib/config_import_validation_contract.test.mjs tests/lib/config-import-pricing-template-normalization.test.mjs tests/lib/profile_scope_header_contract.test.mjs tests/lib/config_api_contract.test.mjs tests/lib/observability_api_contract.test.mjs tests/lib/management_api_model_targets_contract.test.mjs tests/lib/model_dialog_i18n_contract.test.mjs tests/lib/model_form_state_contract.test.mjs tests/lib/dashboard_contract.test.mjs tests/lib/dashboard_bootstrap_contract.test.mjs tests/lib/dashboard_realtime_reconnect_contract.test.mjs tests/lib/dashboard_routing_flow_layout_contract.test.mjs tests/lib/websocket_contract.test.mjs tests/model-detail/connection_probe_behavior_contract.test.mjs",
    "test:server": "node --test tests/server/server_health_entrypoint.test.mjs",
    "test:config": "playwright test tests/e2e/settings-config-export.spec.ts tests/e2e/settings-config-import.spec.ts",
    "test:e2e": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; let args = process.argv.slice(1); if (args[0] === '--') args = args.slice(1); for (let index = 0; index < args.length - 1; index += 1) { if (args[index] === '--grep' && args[index + 1].startsWith('^context-capability-authoring:')) { args[index + 1] = args[index + 1].slice(1); } } const result = spawnSync('pnpm', ['exec', 'playwright', 'test', ...args], { stdio: 'inherit' }); process.exit(result.status ?? 1);\" --"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@xyflow/react": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
