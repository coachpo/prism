# Prism frontend environment example
#
# Frontend development variables. Production uses the root single-image bundle.
# `./start.sh full` unsets `VITE_API_BASE` and keeps browser traffic same-origin
# through the launcher-local Vite proxy.
# This fresh-seed example targets the default backend port. Change it when the
# selected bootstrap file uses another server.port.

VITE_API_BASE=http://localhost:8000
VITE_GIT_RUN_NUMBER=local
VITE_GIT_REVISION=dev
