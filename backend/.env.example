# Prism backend sample environment for one-time plaintext bootstrap seeding.
#
# Steady-state startup uses PRISM_CONFIG_PATH with a secure copy of the checked-in bootstrap-config.json template.
# Leave PRISM_CONFIG_PATH unset only when you want ./start.sh to seed a launcher-local bootstrap file.

DATABASE_URL=postgres://prism:prism@localhost:15432/prism?sslmode=disable
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-runtime-secret
AUTH_JWT_SECRET=prism-dev-jwt-secret-change-me-2026
CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
WEBAUTHN_ORIGIN=http://localhost:15173
CONFIG_BUNDLE_ENCRYPTION_KEY=replace-with-a-long-random-bundle-key
