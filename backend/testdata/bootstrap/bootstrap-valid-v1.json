{
  "meta": {
    "schemaVersion": 1,
    "revision": 1,
    "createdAt": "2026-04-26T14:00:00Z",
    "updatedAt": "2026-04-26T14:00:00Z"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 18000,
    "docsEnabled": true
  },
  "database": {
    "url": "postgres://prism:bootstrap-password@db.internal:5432/prism?sslmode=disable",
    "runtimePool": {
      "maxConns": 4,
      "minIdleConns": 1
    },
    "managementPool": {
      "maxConns": 12,
      "minIdleConns": 2
    },
    "managementAdmission": {
      "m2MaxConcurrent": 6,
      "m3MaxConcurrent": 2
    }
  },
  "runtime": {
    "bufferingMode": "streaming",
    "secretEncryptionKey": "bootstrap-runtime-secret-encryption-key",
    "transport": {
      "maxIdleConns": 120,
      "maxIdleConnsPerHost": 12,
      "maxConnsPerHost": 24,
      "idleConnTimeout": "45s",
      "responseHeaderTimeout": "15s",
      "tlsHandshakeTimeout": "10s",
      "expectContinueTimeout": "1s"
    }
  },
  "http": {
    "corsAllowedOrigins": [
      "http://localhost:15173",
      "http://127.0.0.1:15173"
    ]
  },
  "auth": {
    "jwtSigningKey": "bootstrap-jwt-signing-secret",
    "accessTokenTtlSeconds": 900,
    "refreshTokenTtlSeconds": 604800,
    "resetCodeTtlSeconds": 600,
    "accessCookieName": "prism_access_token",
    "refreshCookieName": "prism_refresh_token",
    "cookieSecure": false
  },
  "stateTransfer": {
    "bundleEncryptionKey": "bootstrap-bundle-encryption-key"
  }
