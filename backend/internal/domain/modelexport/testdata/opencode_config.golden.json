{
  "$schema": "https://opencode.ai/config.json",
  "model": "prism/gpt-5.6-sol",
  "provider": {
    "prism": {
      "env": [
        "PRISM_API_KEY"
      ],
      "models": {
        "claude-opus-4-8": {
          "cost": {
            "cache_read": 0.5,
            "cache_write": 6.25,
            "context_over_200k": {
              "cache_read": 1,
              "cache_write": 12.5,
              "input": 10,
              "output": 37.5
            },
            "input": 5,
            "output": 25
          },
          "name": "Claude Opus 4.8",
          "provider": {
            "api": "https://prism.example/v1",
            "npm": "@ai-sdk/anthropic"
          }
        },
        "gemini-4-pro": {
          "modalities": {
            "output": [
              "text"
            ]
          },
          "name": "Gemini 4 Pro",
          "provider": {
            "api": "https://prism.example/v1beta",
            "npm": "@ai-sdk/google"
          }
        },
        "glm-5.2": {
          "interleaved": {
            "field": "reasoning_content"
          },
          "provider": {
            "api": "https://prism.example/v1",
            "npm": "@ai-sdk/openai-compatible"
          }
        },
        "gpt-5.6-sol": {
          "cost": {
            "cache_read": 0.3,
            "cache_write": 3.75,
            "input": 3,
            "output": 15
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          },
          "provider": {
            "api": "https://prism.example/v1",
            "npm": "@ai-sdk/openai"
          },
          "reasoning": true,
          "variants": {
            "high": {
              "include": [
                "reasoning.encrypted_content"
              ],
              "reasoningEffort": "high",
              "reasoningSummary": "auto"
            },
            "minimal": {
              "include": [
                "reasoning.encrypted_content"
              ],
              "reasoningEffort": "minimal",
              "reasoningSummary": "auto"
            }
          }
        }
      },
      "name": "Prism"
    }
  }
}
