      "runtimeExecution": { "maxConns": 16, "minIdleConns": 2 },
      "runtimeTelemetry": { "maxConns": 8, "minIdleConns": 1 },
      "runtimeFeedback": { "maxConns": 4, "minIdleConns": 0 },
      "cacheRefresh": { "maxConns": 4, "minIdleConns": 0 },
      "backgroundJobs": { "maxConns": 4, "minIdleConns": 0 }
