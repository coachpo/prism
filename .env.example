# Prism environment example
#
# Supported live backend startup uses a canonical bootstrap JSON plus two external inputs:
# - PRISM_CONFIG_PATH points at bootstrap-config.json
# - PRISM_CONFIG_MASTER_KEY decrypts secretPayload entries inside that file
#
# When the file exists, Prism loads startup settings from it and the legacy app env
# vars below are no longer the supported steady-state config surface. When the file
# is missing, Prism can seed it once from those legacy inputs and continue booting.
#
# Prefer an absolute PRISM_CONFIG_PATH for direct backend runs. If you use ./start.sh,
# relative PRISM_CONFIG_PATH values are resolved from the repo root.
#
# Leave PRISM_CONFIG_PATH unset in `.env` if you want ./start.sh to create a
# launcher-local temporary bootstrap file automatically. PRISM_CONFIG_MASTER_KEY
# must still be set explicitly.
PRISM_CONFIG_PATH=/absolute/path/to/bootstrap-config.json
PRISM_CONFIG_MASTER_KEY=replace-with-a-long-random-bootstrap-master-key

# Legacy startup env -> one-time bootstrap seed inputs (used only when the bootstrap file is missing)
# `./start.sh` provisions local PostgreSQL on port 15432 and forces launcher-local backend seeding to port 18000.
# Edit these values for non-launcher direct runs.
DATABASE_URL=postgres://prism:prism@localhost:15432/prism?sslmode=disable
HOST=0.0.0.0
PORT=8000
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional runtime upstream transport tuning for bootstrap seeding (Go duration syntax)
# RUNTIME_TRANSPORT_MAX_IDLE_CONNS=100
# RUNTIME_TRANSPORT_MAX_IDLE_CONNS_PER_HOST=8
# RUNTIME_TRANSPORT_MAX_CONNS_PER_HOST=0
# RUNTIME_TRANSPORT_IDLE_CONN_TIMEOUT=90s
# RUNTIME_TRANSPORT_RESPONSE_HEADER_TIMEOUT=0s
# RUNTIME_TRANSPORT_TLS_HANDSHAKE_TIMEOUT=10s
# RUNTIME_TRANSPORT_EXPECT_CONTINUE_TIMEOUT=1s
# Runtime telemetry and runtime proxy-key usage now durably enqueue by default.
# The legacy synchronous runtime telemetry mode has been retired from the runtime lane.

# Authentication and secret seed inputs
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Optional config-bundle encryption seed input for profile/vendor export-import bundles.
# Those bundle flows remain PostgreSQL-backed state transport; they are not bootstrap ownership.
# When unset, Prism falls back to PRISM_CONFIG_MASTER_KEY.
CONFIG_BUNDLE_ENCRYPTION_KEY=replace-with-a-long-random-bundle-encryption-key
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_RESET_CODE_TTL_SECONDS=600
AUTH_COOKIE_NAME=prism_access_token
AUTH_REFRESH_COOKIE_NAME=prism_refresh_token
AUTH_COOKIE_SECURE=false

# Sample-only values with no current backend startup consumer
LOG_LEVEL=info
CONNECT_TIMEOUT=60.0
READ_TIMEOUT=240.0
WRITE_TIMEOUT=120.0
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Prism LLM Gateway"
WEBAUTHN_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=Prism
SMTP_USE_TLS=true

# Frontend build/runtime
# For standalone frontend work against a direct backend run; ./start.sh full unsets this
# and keeps browser traffic same-origin through the launcher-local Vite proxy.
VITE_API_BASE=http://localhost:8000
VITE_GIT_RUN_NUMBER=local
VITE_GIT_REVISION=dev
